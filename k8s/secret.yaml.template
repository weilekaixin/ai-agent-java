# Copy to secret.yaml, fill in values, then: kubectl apply -f k8s/secret.yaml
# DO NOT commit secret.yaml to version control.
apiVersion: v1
kind: Secret
metadata:
  name: ai-agent-java-secret
  namespace: ai-agent
type: Opaque
stringData:
  AGENT_BASE_URL: "http://ai-agent:80"
  AGENT_API_KEY: "CHANGE_ME"
